// Carpeta: Semáforo
[Aviso decisión humana] =
"La herramienta apoya la decisión; la decisión final corresponde al reclutador."

// Tablas calculadas del semáforo (Modelado > Nueva tabla)
Entrada Campaña = SELECTCOLUMNS(DISTINCT(dim_campana[campana]), "campana", dim_campana[campana])
Entrada Turno = DATATABLE("Turno", STRING, {{"Mañana"}, {"Tarde"}, {"Noche"}, {"Rotativo"}})
Entrada Nivel educativo = DATATABLE("Nivel educativo", STRING, {{"Bachiller"}, {"Técnico"}, {"Tecnólogo"}, {"Profesional"}})
Entrada Canal = DATATABLE("Canal", STRING, {{"Referido"}, {"Portal de empleo"}, {"Redes sociales"}, {"Feria"}})
Entrada Distancia = SELECTCOLUMNS(GENERATESERIES(0, 100, 1), "Distancia km", [Value])
Entrada Experiencia = SELECTCOLUMNS(GENERATESERIES(0, 120, 1), "Experiencia meses", [Value])
Entrada Puntaje = SELECTCOLUMNS(GENERATESERIES(0, 100, 1), "Puntaje", [Value])
